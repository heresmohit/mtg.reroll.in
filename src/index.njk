---
layout: base.njk
title: Upcoming Events
showCustomEvents: false
---

<div class="events-root">

  {% set shownCount = 0 %}
  {% for ev in events %}
  {% if (showCustomEvents or (ev.tags and "UC" in ev.tags)) and filters.eventType(ev.title) != "workshop" %}
    {% set shownCount = shownCount + 1 %}
    {% set dateLabel = "" %}
    {% if ev.dateLine %}
      {% set dateLabel = ev.dateLine %}
    {% elif ev.event_starts_at %}
      {% set dateLabel = filters.formatDate(ev.event_starts_at) ~ " · " ~ filters.formatTime(ev.event_starts_at) %}
    {% endif %}

    {% set img = null %}
    {% if ev.thumbnails and ev.thumbnails.length %}
      {% set img = ev.thumbnails[0].url %}
    {% elif ev.image_url %}
      {% set img = ev.image_url %}
    {% endif %}

    {% set evType = filters.eventType(ev.title) %}
    <div class="mtg-card event-type-{{ evType }}">
      <div class="mtg-card-inner">

        <div class="mtg-title-bar">
          <span class="mtg-card-name">{{ ev.title }}</span>
        </div>

        <div class="mtg-art-box">
          {% if img %}
            <img src="{{ img }}" alt="{{ ev.title }}">
          {% else %}
            <div class="mtg-art-placeholder"></div>
          {% endif %}
        </div>

        <div class="mtg-type-line">
          {% if dateLabel %}{{ dateLabel }}{% else %}Upcoming Event{% endif %}
        </div>

        <div class="mtg-text-box">
          <p class="mtg-flavour-text">{{ filters.shortText(ev.excerpt or ev.full_content, 160) }}</p>
          <div class="mtg-buttons">
            <a class="btn btn-primary" href="{{ ev.url or social.district }}" target="_blank">Buy Ticket</a>
            <a class="btn btn-ghost" href="{{ ev.learn_more }}" target="_blank">Learn More</a>
          </div>
        </div>

      </div>
    </div>
  {% endif %}
  {% endfor %}

  {% if shownCount == 0 %}
    <div class="empty-state">
      <h2>No upcoming events</h2>
      <p>join our socials in the meantime!</p>
      <p class="warning">if you think this is an error please contact us.</p>
    </div>
  {% endif %}

  <div class="social-cards-row">

    <a class="social-card social-card-reroll" href="{{ social.reroll }}" target="_blank">
      <div class="mtg-card-inner">
        <div class="mtg-title-bar">
          <span class="mtg-card-name">Reroll 🎲</span>
        </div>
        <div class="mtg-text-box">
          <p class="mtg-flavour-text">Board games, D&D, and more — our community hub for all tabletop games.</p>
          <span class="btn btn-primary">Forum</span>
        </div>
      </div>
    </a>

    <a class="social-card social-card-instagram" href="{{ social.instagram }}" target="_blank">
      <div class="mtg-card-inner">
        <div class="mtg-title-bar">
          <img src="https://cdn.simpleicons.org/instagram/E4405F" alt="" class="social-card-icon">
          <span class="mtg-card-name">Instagram</span>
        </div>
        <div class="mtg-text-box">
          <p class="mtg-flavour-text">Follow us for event announcements, highlights, and community updates.</p>
          <span class="btn btn-primary">Follow</span>
        </div>
      </div>
    </a>

    <a class="social-card social-card-underline" href="{{ social.underline }}" target="_blank">
      <div class="mtg-card-inner">
        <div class="mtg-title-bar">
          <span class="mtg-card-name">Underline</span>
          <img src="https://cdn.simpleicons.org/linktree/8B5CF6" alt="" class="social-card-icon">
        </div>
        <div class="mtg-art-box social-card-art">
          <img src="https://underline.center/uploads/default/original/1X/fa3aa3aa7f1fa6a624fc878105340deb1881033e.png" alt="Underline Center">
        </div>
        <div class="mtg-text-box">
          <p class="mtg-flavour-text">Browse and register for all our events on Underline Center.</p>
          <span class="btn btn-primary">Visit</span>
        </div>
      </div>
    </a>

    <a class="social-card social-card-whatsapp" href="{{ social.whatsapp }}" target="_blank">
      <div class="mtg-card-inner">
        <div class="mtg-title-bar">
          <span class="mtg-card-name">WhatsApp</span>
          <img src="https://cdn.simpleicons.org/whatsapp/25D366" alt="" class="social-card-icon">
        </div>
        <div class="mtg-text-box">
          <p class="mtg-flavour-text">Join the group to stay in the loop on events, pickups, and trades.</p>
          <span class="btn btn-primary">Join</span>
        </div>
      </div>
    </a>

  </div>

</div>
