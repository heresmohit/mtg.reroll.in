<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MTG Reroll – {{ title }}</title>
  <link rel="stylesheet" href="/assets/events.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700;900&family=Archivo:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>

<body>
  <div class="page-hero">
    <h1 class="hero-title">MAGIC THE GATHERING</h1>

    <p class="tagline">The only (as far as we know) MTG group in Bangalore!<br>Beginners and veterans welcome!</p>
    <h2>UPCOMING EVENTS👇</h2>
  </div>

  <main>
    {{ content | safe }}
  </main>

  <div id="card-overlay"></div>

  <footer class="footer">
    built with love by <a href="https://instagram.com/heresmohit" target="_blank">MG</a>
  </footer>

  <script>
    window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
  </script>
  <script defer src="/_vercel/insights/script.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      var overlay = document.getElementById('card-overlay');
      var focused = null;

      function focusCard(card) {
        var from = card.getBoundingClientRect();
        card.classList.add('is-focused');
        var to = card.getBoundingClientRect();

        var dx = from.left - to.left;
        var dy = from.top  - to.top;
        var scaleX = from.width  / to.width;
        var scaleY = from.height / to.height;

        card.style.transition = 'none';
        card.style.transform  = 'translate(' + dx + 'px, ' + dy + 'px) rotate(0deg) scale(' + scaleX + ', ' + scaleY + ')';

        card.getBoundingClientRect();
        card.classList.add('is-flipping');
        card.style.transition = '';
        card.style.transform  = 'rotate(0deg)';

        card.addEventListener('transitionend', function cleanup() {
          card.classList.remove('is-flipping');
          card.removeEventListener('transitionend', cleanup);
        });

        overlay.classList.add('is-visible');
        focused = card;
      }

      function dismissCard() {
        if (!focused) return;
        var card = focused;
        focused = null;

        // 1. READ — current centered position
        var from = card.getBoundingClientRect();

        // 2. Remove focused state — card snaps back to fan in DOM
        card.classList.remove('is-focused');

        // 3. READ — where it will naturally rest in the fan
        var to = card.getBoundingClientRect();

        // 4. Hold it at the centered position visually
        var dx = from.left - to.left;
        var dy = from.top  - to.top;
        var scaleX = from.width  / to.width;
        var scaleY = from.height / to.height;

        card.style.transition = 'none';
        card.style.transform  = 'translate(' + dx + 'px, ' + dy + 'px) scale(' + scaleX + ', ' + scaleY + ')';

        card.getBoundingClientRect();
        card.classList.add('is-flipping');
        card.style.transition = '';
        card.style.transform  = '';

        card.addEventListener('transitionend', function cleanup() {
          card.classList.remove('is-flipping');
          card.style.transition = '';
          card.style.transform  = '';
          card.removeEventListener('transitionend', cleanup);
        });

        overlay.classList.remove('is-visible');
      }

      document.querySelectorAll('.social-card').forEach(function (card) {
        card.addEventListener('click', function (e) {
          if (card.classList.contains('is-focused')) return; // second tap navigates
          e.preventDefault();
          if (focused && focused !== card) dismissCard();
          focusCard(card);
        });
      });

      overlay.addEventListener('click', dismissCard);
    });
  </script>
</body>
</html>
